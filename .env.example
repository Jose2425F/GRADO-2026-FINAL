# ─────────────────────────────────────────────────────────────
#  Configuración del prototipo. Copia este archivo a `.env` y
#  rellena tus llaves. NUNCA subas `.env` al repositorio.
# ─────────────────────────────────────────────────────────────

# Proveedor del LLM: "anthropic" o "openai"
LLM_PROVIDER=anthropic

# Modelo por proveedor (el que no uses puede quedar como está)
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_MODEL=gpt-4o

# Llaves de API (rellena solo la del proveedor que uses)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Hiperparámetros del experimento (idénticos en ambos brazos — numeral 1.6.3)
LLM_TEMPERATURE=0.2
LLM_TOP_P=1.0
LLM_MAX_TOKENS=4096

# Disyuntor de tokens (salvaguarda operativa — numeral 1.6.4)
# Presupuesto máximo de tokens por corrida y por agente.
TOKEN_BUDGET_POR_CORRIDA=200000
TOKEN_BUDGET_POR_AGENTE=60000

# API de NVD para validación cruzada de CVE (RF-08). Opcional: sin llave
# funciona con rate-limit bajo; con llave sube el límite.
NVD_API_KEY=

# Observabilidad (RF-09). Se activa en el incremento 5.
PHOENIX_ENABLED=false
