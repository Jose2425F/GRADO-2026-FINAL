<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>DualStack · Centro de operaciones</title>
<style>
:root{color-scheme:dark;--bg:#0b1019;--panel:#111925;--line:#253041;--text:#eef3f9;--muted:#93a4ba;--accent:#b2e77a;--blue:#7eb5ff;--amber:#edc077;--red:#f19090;--radius:14px;font-family:Inter,ui-sans-serif,system-ui,-apple-system,sans-serif}*{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--text);font-size:14px}button,input,select{font:inherit}button,a,input,select{outline-offset:5px}button{cursor:pointer}a{color:var(--blue);text-decoration:none}a:hover{text-decoration:underline}button:disabled{cursor:default;opacity:.5}svg{vertical-align:middle}.icon{width:19px;height:19px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round;flex-shrink:0}aside{position:fixed;inset:0 auto 0 0;width:222px;border-right:1px solid var(--line);background:#0d141f;padding:28px 18px;display:flex;flex-direction:column;gap:35px}.brand{display:flex;gap:10px;align-items:center;padding:0 8px;font-weight:720;font-size:22px;letter-spacing:-.7px}.brand-logo{display:grid;place-items:center;width:35px;height:38px;background:var(--accent);color:#172918;border-radius:10px}.brand small{font-size:10px;letter-spacing:2px;display:block;color:var(--muted);margin-top:4px;font-weight:500}.nav-label,.eyebrow{font-size:10px;letter-spacing:1.8px;color:var(--muted);font-weight:650;text-transform:uppercase}.nav-label{padding:0 12px 12px}nav{display:grid;gap:8px}nav button{background:transparent;color:var(--muted);border:0;padding:13px 12px;border-radius:9px;text-align:left;display:flex;align-items:center;gap:12px}nav button:hover{background:#172232;color:var(--text)}nav button.active{color:var(--accent);background:#203026}.lab-note{margin-top:auto;border:1px solid var(--line);border-radius:12px;padding:14px;font-size:12px;line-height:1.7;color:var(--muted)}.lab-note b{display:block;color:var(--text);font-weight:550;margin-bottom:5px}.dot{width:7px;height:7px;display:inline-block;border-radius:50%;background:var(--accent);margin-right:7px}.side-footer{color:#607188;font-size:11px;padding:0 10px}main{margin-left:222px;padding:30px 38px;max-width:1780px}.topbar{display:flex;justify-content:space-between;align-items:center;gap:18px;margin-bottom:32px}.breadcrumb{color:var(--muted);font-size:12px;display:flex;gap:10px;align-items:center}.breadcrumb span:last-child{color:var(--text)}.top-actions{display:flex;align-items:center;gap:12px}.badge{display:inline-flex;gap:6px;align-items:center;padding:5px 9px;border-radius:6px;border:1px solid #2f4738;background:#19291f;color:var(--accent);font-size:11px;font-weight:550;white-space:nowrap}.badge.neutral{background:#1b2635;color:#b1c2d8;border-color:#304057}.badge.warn{color:var(--amber);background:#30271b;border-color:#54432b}.badge.error{color:var(--red);background:#322227;border-color:#553139}.button{border:1px solid var(--line);color:var(--text);background:#151f2d;border-radius:8px;padding:9px 13px;display:inline-flex;align-items:center;justify-content:center;gap:8px;font-size:12px}.button:hover{background:#1e2c3e;border-color:#41506a}.button.primary{color:#162317;background:var(--accent);border-color:var(--accent);font-weight:650}.button.primary:hover{background:#c0ed95}.page-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:22px;margin-bottom:24px}h1{font-size:30px;letter-spacing:-1px;font-weight:620;margin:7px 0 9px}p{line-height:1.6}.subtitle{color:var(--muted);font-size:13px;margin:0}.updated{color:var(--muted);font-size:11px;white-space:nowrap}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:24px}.stat{background:var(--panel);border:1px solid var(--line);padding:19px 21px;border-radius:var(--radius)}.stat-top{display:flex;justify-content:space-between;align-items:center;color:var(--muted);font-size:12px}.stat-top .icon{color:var(--blue);width:17px}.stat-number{font-size:32px;font-weight:580;letter-spacing:-1px;margin:12px 0 9px;font-variant-numeric:tabular-nums}.stat-number small{font-size:15px;color:var(--muted);letter-spacing:0;font-weight:400}.stat-foot{color:var(--muted);font-size:11px;line-height:1.5}.positive{color:var(--accent)}.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;margin-bottom:20px}.panel-head{padding:20px 23px;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;gap:15px}.panel-head h2{font-size:15px;font-weight:580;letter-spacing:-.2px;margin:0}.panel-head p{margin:6px 0 0;color:var(--muted);font-size:11px}.run-header{display:flex;align-items:center;gap:13px;min-width:0}.run-symbol{width:42px;height:42px;background:#203026;border:1px solid #344931;border-radius:11px;color:var(--accent);display:grid;place-items:center}.run-title{min-width:0}.run-title h2{max-width:580px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.mono{font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:11px}.split{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(300px,1fr);gap:20px}.panel-body{padding:22px 23px}.progress-meta{display:flex;align-items:center;justify-content:space-between;gap:10px;font-size:12px;margin-bottom:12px}.progress-track{height:7px;background:#263243;border-radius:10px;overflow:hidden}.progress-fill{height:100%;background:var(--accent);border-radius:10px;transition:width .6s;max-width:100%}.run-meta{display:flex;flex-wrap:wrap;gap:22px;color:var(--muted);font-size:11px;margin-top:16px}.run-meta strong{color:var(--text);font-weight:500;margin-left:5px}.tabs{display:flex;gap:21px;padding:0 23px;border-bottom:1px solid var(--line)}.tabs button{border:0;background:transparent;color:var(--muted);font-size:12px;padding:17px 0;border-bottom:2px solid transparent}.tabs button.active{color:var(--accent);border-color:var(--accent)}.agents{display:grid;gap:13px}.agent{padding:16px;border:1px solid var(--line);border-radius:10px;background:#0e1622}.agent-top{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:13px}.agent-name{display:flex;align-items:center;gap:10px;font-size:12px;font-weight:500}.agent-name .icon{color:var(--muted);width:17px}.agent-meta{display:flex;justify-content:space-between;font-size:10px;color:var(--muted);margin:10px 0 0}.agent .progress-track{height:4px}.agent-task{color:var(--muted);font-size:11px;margin-top:9px;overflow-wrap:anywhere}.terminal{font-size:12px;color:var(--muted);padding:13px 15px;background:#17202d;border:1px solid var(--line);border-radius:9px;line-height:1.7;margin-bottom:18px}.terminal strong{color:var(--text);font-weight:500}.activity{display:grid;gap:0;max-height:477px;overflow:auto}.event{display:flex;gap:12px;padding:13px 0;border-bottom:1px solid #202b3a}.event:last-child{border:0}.event-dot{width:8px;height:8px;border:2px solid var(--blue);border-radius:50%;margin-top:5px;flex-shrink:0}.event-dot.error{border-color:var(--amber)}.event-content{flex:1;min-width:0}.event-title{font-size:12px;line-height:1.6}.event-desc{font-size:10px;line-height:1.6;color:var(--muted);overflow-wrap:anywhere;margin-top:3px}.event time{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums;white-space:nowrap;padding-top:3px}.table-wrap{overflow:auto}table{width:100%;border-collapse:collapse;text-align:left;font-size:12px;white-space:nowrap}th{color:var(--muted);background:#0e1621;font-size:10px;text-transform:uppercase;letter-spacing:1px;font-weight:500;padding:12px 22px}td{padding:15px 22px;border-bottom:1px solid #243040}tbody tr:last-child td{border:0}tbody tr.selected{background:#1b2a25}tbody tr:hover{background:#1a2635}.table-id{border:0;background:none;color:var(--text);padding:0;text-align:left;max-width:305px;overflow:hidden;text-overflow:ellipsis;display:block;font-size:12px}.table-id:hover{color:var(--accent)}td small{display:block;color:var(--muted);font-size:10px;margin-top:5px}.filters{display:flex;gap:10px;flex-wrap:wrap;padding:16px 22px}.filters input,.filters select,select.study{color:var(--text);border:1px solid var(--line);background:#0d1521;border-radius:8px;padding:9px 11px;font-size:12px}.filters input{flex:1;min-width:170px}.table-footer{display:flex;justify-content:space-between;align-items:center;gap:14px;border-top:1px solid var(--line);padding:14px 22px;color:var(--muted);font-size:11px}.pagination{display:flex;gap:8px}.kpi-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px}.kpi{border:1px solid var(--line);border-radius:10px;padding:17px;background:#0e1622}.kpi-heading{display:flex;justify-content:space-between;gap:10px;color:var(--muted);font-size:11px}.kpi-number{font-size:27px;font-weight:550;letter-spacing:-.5px;margin:12px 0}.kpi p{font-size:11px;color:var(--muted);margin:8px 0}.kpi .progress-track{height:4px}.notice{margin-bottom:17px;background:#292419;border:1px solid #4d422c;border-radius:9px;padding:12px 14px;font-size:11px;line-height:1.7;color:var(--amber)}.notice.info{color:#adc8ef;background:#162234;border-color:#293f5f}.artifact-links{display:flex;flex-wrap:wrap;gap:9px;margin-top:16px}.empty{padding:30px 15px;text-align:center;color:var(--muted);line-height:1.8;font-size:12px}.empty .icon{display:block;margin:0 auto 13px;width:30px;height:30px;color:#57708e}.subgrid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.detail-label{color:var(--muted);font-size:10px;margin-bottom:6px}.detail-value{font-size:12px;overflow-wrap:anywhere}.section-foot{color:var(--muted);font-size:11px;margin:0 0 26px;line-height:1.7}.footer{display:flex;justify-content:space-between;gap:12px;border-top:1px solid var(--line);padding-top:20px;color:#71839b;font-size:10px;line-height:1.8}.error-banner{padding:12px 18px;border:1px solid #674035;border-radius:9px;background:#302019;color:var(--amber);margin-bottom:20px;font-size:12px}[hidden]{display:none!important}.tab-area{max-height:610px;overflow:auto}.tab-area .table-wrap table td{font-size:11px}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}
@media(min-width:1500px){.agents{grid-template-columns:1fr 1fr}}@media(max-width:1150px){aside{width:188px}main{margin-left:188px;padding:26px 24px}.split{grid-template-columns:1fr}.stats{gap:10px}.stat{padding:17px}.stat-number{font-size:28px}.page-heading{align-items:start}.updated{white-space:normal}.kpi-grid{gap:10px}.run-title h2{max-width:470px}}@media(max-width:760px){aside{position:static;width:100%;padding:16px;border-right:0;border-bottom:1px solid var(--line);gap:18px}.brand{font-size:20px}.brand small{display:none}aside nav{display:flex;gap:5px}nav button{font-size:12px;padding:10px}nav .icon{width:16px}.nav-label,.lab-note,.side-footer{display:none}main{margin:0;padding:22px 16px}.topbar{margin-bottom:24px}.breadcrumb{display:none}.top-actions{width:100%;justify-content:space-between}.page-heading{display:block}.updated{margin-top:14px}.stats{grid-template-columns:1fr 1fr}.stat-number{font-size:27px}h1{font-size:27px}.panel-head{padding:17px}.panel-body{padding:17px}.run-title h2{max-width:220px;font-size:12px}.panel-head:has(.study){align-items:start;flex-direction:column}.kpi-grid{grid-template-columns:1fr}.run-meta{gap:12px}.footer{flex-direction:column}.filters{padding:14px}.table-footer{padding:12px 14px}.run-header+.badge{font-size:9px}.subgrid{grid-template-columns:1fr}}
@media(prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
</style>
</head>
<body>
<aside>
<div class="brand"><div class="brand-logo" data-icon="shield"></div><div>DualStack<small>AUDIT LAB</small></div></div>
<div><div class="nav-label">Espacio de trabajo</div><nav aria-label="Navegación principal"><button class="active" data-nav="overview" data-icon-before="grid">Seguimiento</button><button data-nav="history" data-icon-before="layers">Auditorías</button><button data-nav="experiments" data-icon-before="chart">Experimentos</button></nav></div>
<div class="lab-note"><b><span class="dot"></span>Laboratorio local</b>IPv4 + IPv6<br>Banco de pruebas controlado<br><span class="mono">127.0.0.1</span></div>
<div class="side-footer">Proyecto de grado · 2026<br>Observación de evidencia real</div>
</aside>
<main>
<div class="topbar"><div class="breadcrumb">Laboratorio <span>/</span><span>Centro de operaciones</span></div><div class="top-actions"><span id="connection" class="badge"><span class="dot"></span>Conectando</span><button id="follow" class="button" hidden>Seguir última corrida</button><button id="pause" class="button" data-icon-before="pause">Pausar</button><button id="refresh" class="button" data-icon-before="refresh">Actualizar</button></div></div>
<div class="page-heading"><div><div class="eyebrow">CONTROL Y OBSERVABILIDAD</div><h1>Centro de operaciones</h1><p class="subtitle">Sigue cada tarea, revisa la evidencia y evalúa el desempeño de los agentes.</p></div><div class="updated" id="updated">Última actualización —</div></div>
<div id="connection-error" class="error-banner" role="status" hidden>Se perdió la conexión con el panel. Los datos visibles corresponden a la última actualización.</div>
<section class="stats" aria-label="Resumen de la corrida seleccionada">
<div class="stat"><div class="stat-top">Avance de la auditoría <span data-icon="layers"></span></div><div id="stat-progress" class="stat-number">—</div><div id="stat-tasks" class="stat-foot">Selecciona una corrida</div></div>
<div class="stat"><div class="stat-top">Hallazgos verificados <span data-icon="shield"></span></div><div id="stat-findings" class="stat-number">—</div><div id="stat-findings-note" class="stat-foot">Validación independiente</div></div>
<div class="stat"><div class="stat-top">Tokens conocidos <span data-icon="cpu"></span></div><div id="stat-tokens" class="stat-number">—</div><div id="stat-token-note" class="stat-foot">Uso registrado por el proveedor</div></div>
<div class="stat"><div class="stat-top">Tiempo transcurrido <span data-icon="clock"></span></div><div id="stat-time" class="stat-number">—</div><div id="stat-time-note" class="stat-foot">Medición de la corrida</div></div>
</section>
<section id="overview" class="split">
<div class="panel"><div class="panel-head"><div class="run-header"><div class="run-symbol" data-icon="activity"></div><div class="run-title"><h2 id="run-title">Sin auditorías registradas</h2><p id="run-subtitle">Las corridas aparecerán al iniciar el auditor.</p></div></div><span id="run-status" class="badge neutral">En espera</span></div>
<div class="panel-body"><div class="progress-meta"><span id="progress-label">Progreso de tareas</span><strong id="progress-value">—</strong></div><div class="progress-track" role="progressbar" aria-label="Tareas finalizadas" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="main-progress"><div id="progress-fill" class="progress-fill" style="width:0%"></div></div><div id="run-meta" class="run-meta"></div></div>
<div class="tabs" role="tablist" aria-label="Detalle de auditoría"><button class="active" role="tab" aria-selected="true" aria-controls="tab-agents" id="btn-agents" data-tab="agents">Agentes</button><button role="tab" aria-selected="false" aria-controls="tab-tasks" id="btn-tasks" data-tab="tasks">Tareas</button><button role="tab" aria-selected="false" aria-controls="tab-evidence" id="btn-evidence" data-tab="evidence">Resultados</button></div>
<div class="tab-area"><div id="tab-agents" class="panel-body" role="tabpanel" aria-labelledby="btn-agents"><div id="current-action" class="terminal">Esperando actividad del auditor.</div><div id="agents" class="agents"></div></div><div id="tab-tasks" role="tabpanel" aria-labelledby="btn-tasks" hidden><div class="table-wrap"><table><thead><tr><th>Perfil / activo</th><th>Agente</th><th>Estado</th></tr></thead><tbody id="task-list"></tbody></table></div></div><div id="tab-evidence" class="panel-body" role="tabpanel" aria-labelledby="btn-evidence" hidden></div></div>
</div>
<div class="panel"><div class="panel-head"><div><h2>Bitácora de actividad</h2><p>Últimos 60 eventos de la corrida seleccionada</p></div><span data-icon="activity" style="color:var(--muted)"></span></div><div class="panel-body"><div id="events" class="activity"></div></div></div>
</section>
<section id="experiments" class="panel"><div class="panel-head"><div><h2>Desempeño experimental</h2><p>Single vs. multiagent · evaluación por pares equivalentes</p></div><label><span class="sr-only">Seleccionar experimento</span><select id="study" class="study"></select></label></div><div class="panel-body" id="kpi-body"></div></section>
<p class="section-foot">TRTO: reducción del tiempo · IDE: incremento de detección · ETV: eficiencia de tokens por hallazgo. Las observaciones IPv6 candidatas no se contabilizan como vulnerabilidades confirmadas.</p>
<section id="history" class="panel"><div class="panel-head"><div><h2>Historial de auditorías</h2><p>Selecciona una corrida para inspeccionar su progreso y resultados.</p></div><span class="badge neutral" id="run-count">0 corridas</span></div>
<div class="filters"><label class="sr-only" for="search">Buscar auditoría</label><input id="search" placeholder="Buscar por ID o modelo…" type="search"><label class="sr-only" for="architecture">Arquitectura</label><select id="architecture"><option value="all">Todas las arquitecturas</option><option value="multiagent">Multiagent</option><option value="single">Single</option></select><label class="sr-only" for="status-filter">Estado</label><select id="status-filter"><option value="all">Todos los estados</option><option value="running">En curso</option><option value="complete">Completada</option><option value="partial">Parcial</option><option value="interrupted">Interrumpida</option></select></div>
<div class="table-wrap"><table><thead><tr><th>Auditoría / modelo</th><th>Arquitectura</th><th>Estado</th><th>Hallazgos</th><th>Tokens</th><th>Duración</th></tr></thead><tbody id="history-list"></tbody></table></div><div class="table-footer"><span id="page-count">Sin corridas</span><div class="pagination"><button id="prev" class="button" aria-label="Página anterior">←</button><button id="next" class="button" aria-label="Página siguiente">→</button></div></div>
</section>
<footer class="footer"><span>DualStack Audit Lab · Trabajo de grado 2026</span><span>Panel local de observación · Los resultados se obtienen de la bitácora y los informes.</span></footer>
</main>
<script id="initial-state" type="application/json">{{ state|tojson }}</script>
<script>
'use strict';
const LIVE={{ live|tojson }};
const icons={shield:'<path d="M12 3 4 6v6c0 5 8 9 8 9s8-4 8-9V6l-8-3Z"/><path d="m8 12 3 3 5-6"/>',grid:'<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',layers:'<path d="m12 3 9 5-9 5-9-5 9-5Zm-9 9 9 5 9-5M3 16l9 5 9-5"/>',chart:'<path d="M4 3v17h17M8 15v-4m5 4V6m5 9V9"/>',cpu:'<rect x="6" y="6" width="12" height="12" rx="2"/><path d="M9 3v3m6-3v3M9 18v3m6-3v3M3 9h3m-3 6h3m12-6h3m-3 6h3"/>',clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',activity:'<path d="M2 12h5l3-8 4 16 3-8h5"/>',refresh:'<path d="M20 7v5h-5M4 17v-5h5"/><path d="M5.5 7a8 8 0 0 1 13-2L20 8M4 16l1.5 3a8 8 0 0 0 13-2"/>',pause:'<path d="M8 5v14M16 5v14"/>',play:'<path d="m8 5 11 7-11 7V5Z"/>'};
function icon(name){return '<svg class="icon" viewBox="0 0 24 24" aria-hidden="true">'+(icons[name]||icons.cpu)+'</svg>'}
document.querySelectorAll('[data-icon]').forEach(e=>e.innerHTML=icon(e.dataset.icon));
document.querySelectorAll('[data-icon-before]').forEach(e=>e.insertAdjacentHTML('afterbegin',icon(e.dataset.iconBefore)));
const $=id=>document.getElementById(id), num=n=>Number.isFinite(n)?new Intl.NumberFormat('es-CO',{maximumFractionDigits:0}).format(n):'—';
const duration=n=>!Number.isFinite(n)?'—':Math.round(n)<60?Math.round(n)+' s':Math.floor(Math.round(n)/60)+' min '+Math.round(n)%60+' s';
const labels={running:'En curso',complete:'Completada',partial:'Parcial',interrupted:'Interrumpida',pending:'Pendiente',completed:'Completada',completed_no_findings:'Sin hallazgos',skipped:'Omitida',blocked:'Bloqueada',failed:'Fallida',cancelled:'Cancelada',accepted:'Aceptada',fallback:'Respaldo',disabled:'Sin IA',active:'IA activa',live:'Prueba real',dry_run:'Simulación'};
function text(tag,value,cls){const e=document.createElement(tag);e.textContent=value??'—';if(cls)e.className=cls;return e}
function badge(status){return text('span',labels[status]||status,'badge '+(['fallback','partial','blocked','skipped','interrupted'].includes(status)?'warn':['failed','cancelled'].includes(status)?'error':['pending','disabled','dry_run'].includes(status)?'neutral':''))}
function artifact(path,label){const a=text('a',label,'button');a.href=LIVE?'/artifacts/'+path.split('/').map(encodeURIComponent).join('/'):path.split('/').map(encodeURIComponent).join('/');a.target='_blank';a.rel='noopener';return a}
let state=JSON.parse($('initial-state').textContent), selected=null, selectedStudy=null, paused=false, follow=true, page=0, tab='agents', fetching=false;
function empty(container,message){container.replaceChildren();const e=text('div',message,'empty');e.insertAdjacentHTML('afterbegin',icon('layers'));container.append(e)}
function render(){
const runs=state.runs; if(follow||!selected||!runs.some(r=>r.key===selected))selected=runs[0]?.key;
const run=runs.find(r=>r.key===selected);$('follow').hidden=follow;
$('updated').textContent='Actualizado '+new Date(state.updated_at).toLocaleTimeString('es-CO');
$('run-count').textContent=num(runs.length)+' corridas';
$('stat-progress').textContent=run?run.progress+'%':'—';$('stat-tasks').textContent=run?run.finished+' de '+run.total+' tareas finalizadas':'Selecciona una corrida';
$('stat-findings').textContent=num(run?.findings);$('stat-findings-note').textContent=run?.findings==null?'Pendiente de validación final':'Hallazgos con corroboración';
$('stat-tokens').textContent=num(run?.llm.known_tokens);$('stat-token-note').textContent=run?(run.llm.usage_complete?'Uso conocido · '+run.llm.calls+' decisiones':'Medición parcial · uso adicional desconocido'):'Uso registrado por el proveedor';
$('stat-time').textContent=duration(run?.seconds);$('stat-time-note').textContent=run?(run.status==='running'?'Auditoría en ejecución':run.status==='interrupted'?'Tiempo hasta el último evento':'Duración de la corrida'):'Medición de la corrida';
if(run){
$('run-title').textContent=run.id;$('run-subtitle').textContent=(run.architecture==='single'?'Single · ejecución serial':'Multiagent · ramas independientes')+' · '+(labels[run.mode]||run.mode);
$('run-status').replaceWith(Object.assign(badge(run.status),{id:'run-status'}));$('progress-value').textContent=run.progress+'%';$('progress-label').textContent=run.finished+' / '+run.total+' tareas finalizadas';$('progress-fill').style.width=run.progress+'%';$('main-progress').setAttribute('aria-valuenow',run.progress);
$('run-meta').replaceChildren(); for(const [label,value] of [['Objetivos',new Set(run.tasks.map(t=>t.asset).filter(Boolean)).size||'—'],['Modelo',run.llm.model||'Sin IA'],['Estado de IA',labels[run.llm.status]||run.llm.status]]){const e=text('span',label);e.append(text('strong',value));$('run-meta').append(e)}
const active=run.tasks.filter(t=>t.status==='running');const last=run.events[0];
$('current-action').textContent=run.status==='running'?(active.length?'Ejecutando: '+active.map(t=>t.profile+' · '+t.asset).join(' / '):last?.kind==='request_started'?'Consultando al planificador de IA…':'Preparando o seleccionando la próxima tarea autorizada…'):run.status==='interrupted'?'Esta corrida terminó sin informe final. Revisa los últimos eventos de la bitácora.':'Corrida finalizada. Puedes consultar las tareas y los informes de evidencia.';
$('agents').replaceChildren();
for(const agent of run.agents){const card=text('div','','agent'),top=text('div','','agent-top'),name=text('div',agent.name.replace(/^Agente /,''),'agent-name');name.insertAdjacentHTML('afterbegin',icon(agent.id.startsWith('ipv6')?'layers':'cpu'));top.append(name,badge(agent.active?'running':agent.failed?'blocked':agent.finished===agent.total?'completed':'pending'));const track=text('div','','progress-track'),fill=text('div','','progress-fill');fill.style.width=(agent.total?agent.finished/agent.total*100:0)+'%';track.append(fill);const meta=text('div','','agent-meta');meta.append(text('span',agent.finished+' / '+agent.total+' tareas'),text('span',agent.active?agent.active+' activa(s)':agent.failed?agent.failed+' con incidencias':'Sin tarea activa'));card.append(top,track,meta);const task=active.find(t=>t.agent===agent.id);if(task)card.append(text('div',task.profile+' · '+task.asset,'agent-task'));$('agents').append(card)}
if(!run.agents.length)empty($('agents'),'El plan de tareas todavía no está disponible.');
$('task-list').replaceChildren();for(const task of run.tasks){const row=document.createElement('tr'),td=text('td',task.profile||task.id);td.append(text('small',[task.case,task.asset,task.address].filter(Boolean).join(' · ')));const status=text('td','');status.append(badge(task.status));if(task.reason)status.append(text('small',task.reason));row.append(td,text('td',task.agent.replace('ipv4_','IPv4 · ').replace('ipv6_','IPv6 · ')),status);$('task-list').append(row)}
$('tab-evidence').replaceChildren();
if(run.status==='running')$('tab-evidence').append(text('div','Los hallazgos se publican después de la corroboración y la generación de informes.','notice info'));
const details=text('div','','subgrid');for(const [label,value] of [['Verdaderos positivos',num(run.evaluation.TP)],['Falsos positivos',num(run.evaluation.FP)],['Falsos negativos',num(run.evaluation.FN)],['Verdaderos negativos',num(run.evaluation.TN)],['Decisiones de respaldo',num(run.llm.fallbacks)],['Costo equivalente estimado',Number.isFinite(run.llm.cost)?'US$ '+run.llm.cost.toFixed(4):'Sin estimación completa']]){const d=text('div','');d.append(text('div',label,'detail-label'),text('div',value,'detail-value'));details.append(d)}$('tab-evidence').append(details,text('p','El costo estimado no es una factura. TP, FP, FN y TN requieren una evaluación con ground truth.','section-foot'));const links=text('div','','artifact-links');for(const [file,label] of [['report.html','Abrir informe'],['report.pdf','Descargar PDF'],['report.json','Informe JSON'],['evaluation.json','Evaluación']])if(run.artifacts[file])links.append(artifact(run.artifacts[file],label));$('tab-evidence').append(links);
renderEvents(run.events);
}else{empty($('agents'),'Inicia una auditoría desde la terminal para ver su avance.');empty($('events'),'La bitácora aparecerá con la primera corrida.');}
renderStudy();renderHistory();
}
const eventNames={request_accepted:'Solicitud validada',plan_created:'Plan de tareas preparado',task_admitted:'Tarea autorizada e iniciada',task_terminal:'Tarea finalizada',decision:'Decisión del planificador de IA',provider_retry:'Reintento del proveedor',report_saved:'Informes y evidencia publicados',llm_fallback:'Planificación de respaldo',llm_plan:'Planificación de casos IPv6',llm_ready:'Planificador de IA conectado',request_started:'Consulta al modelo de IA',error:'Incidencia del adaptador',route_denied:'Ruta rechazada',ipv6_lab_denied:'Laboratorio IPv6 no disponible'};
function renderEvents(events){$('events').replaceChildren();for(const event of events){const e=text('div','','event'),dot=text('div','','event-dot'+(event.status==='fallback'||event.reason?' error':'')),content=text('div','','event-content');content.append(text('div',(eventNames[event.kind]||event.kind)+(event.status?' · '+(labels[event.status]||event.status):''),'event-title'));content.append(text('div',[event.task||event.component,event.reason,event.http?'HTTP '+event.http:null,Number.isFinite(event.tokens)?num(event.tokens)+' tokens':null].filter(Boolean).join(' · '),'event-desc'));const clock=text('time',new Date(event.time).toLocaleTimeString('es-CO',{hour:'2-digit',minute:'2-digit',second:'2-digit'}));e.append(dot,content,clock);$('events').append(e)}if(!events.length)empty($('events'),'Aún no hay eventos en la bitácora.');}
function renderStudy(){const studies=state.experiments;if(!selectedStudy||!studies.some(e=>e.key===selectedStudy))selectedStudy=studies[0]?.key;const selection=$('study');if(selection.options.length!==studies.length||[...selection.options].some((o,i)=>o.value!==studies[i]?.key)){selection.replaceChildren();for(const study of studies)selection.append(new Option(study.id,study.key))}selection.value=selectedStudy||'';selection.hidden=!studies.length;const body=$('kpi-body');body.replaceChildren();const study=studies.find(e=>e.key===selectedStudy);if(!study){empty(body,'No hay experimentos evaluados. Los KPI aparecerán cuando se guarde evaluation.json.');return;}
body.append(text('div',(study.pilot?'Piloto · ':study.complete?'Cohorte completa · ':'Cohorte incompleta · ')+num(study.pairs_eligible)+' de '+num(study.pairs_planned)+' pares aptos. '+(study.complete?'Resultados de la cohorte evaluada.':'Los valores corresponden únicamente a los pares aptos; no certifican toda la cohorte.'),'notice'+(study.complete?' info':'')));
const grid=text('div','','kpi-grid');for(const [key,title,target,suffix] of [['TRTO_percent','TRTO · Reducción de tiempo',30,'%'],['IDE_percent','IDE · Incremento de detección',20,'%'],['ETV_ratio','ETV · Eficiencia de tokens',1.1,'×']]){const metric=study.analysis[key],value=metric.mean,met=Number.isFinite(value)&&value>=target,card=text('div','','kpi'),head=text('div','','kpi-heading');head.append(text('span',title),text('span',Number.isFinite(value)?met?'Cumple':'No cumple':'Sin datos','badge '+(met?'':'warn')));const track=text('div','','progress-track'),fill=text('div','','progress-fill');fill.style.width=(Number.isFinite(value)?Math.max(0,Math.min(100,value/target*100)):0)+'%';if(!met)fill.style.background='var(--amber)';track.append(fill);card.append(head,text('div',Number.isFinite(value)?value.toFixed(2)+suffix:'—','kpi-number'),track,text('p','Meta ≥ '+target+suffix+' · '+num(metric.n)+' pares evaluados'));grid.append(card)}body.append(grid);const links=text('div','','artifact-links');links.append(artifact(study.artifact,'Consultar evaluación'));body.append(links);}
function renderHistory(){const query=$('search').value.trim().toLowerCase(),arch=$('architecture').value,status=$('status-filter').value;const runs=state.runs.filter(r=>(arch==='all'||r.architecture===arch)&&(status==='all'||r.status===status)&&[r.id,r.llm.model||''].join(' ').toLowerCase().includes(query));page=Math.min(page,Math.max(0,Math.ceil(runs.length/8)-1));const list=$('history-list');list.replaceChildren();for(const run of runs.slice(page*8,page*8+8)){const row=document.createElement('tr');if(run.key===selected)row.className='selected';const id=text('td',''),button=text('button',run.id,'table-id');button.title=run.id;button.addEventListener('click',()=>{selected=run.key;follow=false;render();$('overview').scrollIntoView({behavior:'smooth',block:'start'})});id.append(button,text('small',run.llm.model||'Sin IA · '+(labels[run.mode]||run.mode)));const statusCell=text('td','');statusCell.append(badge(run.status));const tokens=text('td',num(run.llm.known_tokens));if(!run.llm.usage_complete)tokens.append(text('small','Medición parcial'));row.append(id,text('td',run.architecture==='single'?'Single':'Multiagent'),statusCell,text('td',num(run.findings)),tokens,text('td',duration(run.seconds)));list.append(row)}if(!runs.length){const row=document.createElement('tr'),cell=text('td','No hay corridas que coincidan con los filtros.','empty');cell.colSpan=6;row.append(cell);list.append(row)}$('page-count').textContent=runs.length?'Mostrando '+(page*8+1)+'–'+Math.min(page*8+8,runs.length)+' de '+runs.length+' corridas'+(state.runs.length===state.run_limit?' · Últimas '+state.run_limit:''):'Sin corridas';$('prev').disabled=page===0;$('next').disabled=(page+1)*8>=runs.length;}
async function refresh(){if(!LIVE||fetching)return;fetching=true;try{const response=await fetch('/api/state',{cache:'no-store'});if(!response.ok)throw new Error('HTTP '+response.status);state=await response.json();$('connection-error').hidden=true;$('connection').textContent=paused?'Actualización pausada':'En vivo · cada 2 s';$('connection').className='badge'+(paused?' neutral':'');render();}catch{$('connection-error').hidden=false;$('connection').textContent='Sin conexión';$('connection').className='badge warn';}finally{fetching=false;}}
$('follow').addEventListener('click',()=>{follow=true;render();});
$('pause').addEventListener('click',()=>{paused=!paused;$('pause').innerHTML=icon(paused?'play':'pause')+(paused?'Reanudar':'Pausar');$('connection').textContent=paused?'Actualización pausada':'En vivo · cada 2 s';$('connection').className='badge'+(paused?' neutral':'');if(!paused)refresh();});$('refresh').addEventListener('click',refresh);
for(const id of ['search','architecture','status-filter'])$(id).addEventListener(id==='search'?'input':'change',()=>{page=0;renderHistory()});$('prev').addEventListener('click',()=>{page--;renderHistory()});$('next').addEventListener('click',()=>{page++;renderHistory()});$('study').addEventListener('change',()=>{selectedStudy=$('study').value;renderStudy()});
document.querySelectorAll('[data-nav]').forEach(button=>button.addEventListener('click',()=>{document.querySelectorAll('[data-nav]').forEach(e=>e.classList.toggle('active',e===button));$(button.dataset.nav).scrollIntoView({behavior:'smooth',block:'start'})}));
document.querySelectorAll('[data-tab]').forEach(button=>button.addEventListener('click',()=>{tab=button.dataset.tab;document.querySelectorAll('[data-tab]').forEach(e=>{e.classList.toggle('active',e===button);e.setAttribute('aria-selected',e===button?'true':'false')});for(const id of ['agents','tasks','evidence'])$('tab-'+id).hidden=id!==tab;}));
$('connection').textContent=LIVE?'En vivo · cada 2 s':'Vista guardada · sin actualización';$('pause').hidden=!LIVE;$('refresh').hidden=!LIVE;render();if(LIVE)setInterval(()=>{if(!paused)refresh()},2000);
</script>
</body></html>
