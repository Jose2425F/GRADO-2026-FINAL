FROM python:3.13-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/* && pip install --no-cache-dir pyftpdlib==2.2.0 \
    && useradd -m -s /bin/bash labuser && mkdir /run/sshd /srv/ftp
COPY empresa/dmz/credentials_target.py /app/credentials_target.py
CMD ["python", "-u", "/app/credentials_target.py"]
