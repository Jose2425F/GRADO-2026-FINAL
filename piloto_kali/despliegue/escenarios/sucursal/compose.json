{
  "name": "novaflow-suite-sucursal",
  "networks": {
    "dmz": {
      "name": "nf1_dmz",
      "internal": true,
      "driver_opts": {
        "com.docker.network.bridge.name": "br-nf1-dmz"
      },
      "ipam": {
        "config": [
          {
            "subnet": "192.168.112.0/24",
            "gateway": "192.168.112.1"
          }
        ]
      }
    },
    "corp": {
      "name": "nf1_corp",
      "internal": true,
      "enable_ipv6": true,
      "driver_opts": {
        "com.docker.network.bridge.name": "br-nf1-corp"
      },
      "ipam": {
        "config": [
          {
            "subnet": "192.168.110.0/24"
          },
          {
            "subnet": "fd57:2026:110::/64"
          }
        ]
      }
    },
    "datacenter": {
      "name": "nf1_dc",
      "internal": true,
      "enable_ipv6": true,
      "driver_opts": {
        "com.docker.network.bridge.name": "br-nf1-dc"
      },
      "ipam": {
        "config": [
          {
            "subnet": "192.168.111.0/24"
          },
          {
            "subnet": "fd57:2026:111::/64"
          }
        ]
      }
    }
  },
  "services": {
    "portal": {
      "image": "novaflow-lab-credentials:local",
      "container_name": "nf1-portal",
      "hostname": "nf1-portal",
      "cap_drop": [
        "ALL"
      ],
      "cap_add": [
        "CHOWN",
        "SETUID",
        "SETGID",
        "DAC_OVERRIDE",
        "SYS_CHROOT"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "mem_limit": "128m",
      "pids_limit": 64,
      "cpus": 0.5,
      "restart": "no",
      "environment": {
        "LAB_TARGET_PASSWORD": "${LAB_ACTUAL_PORTAL}"
      },
      "networks": {
        "dmz": {
          "ipv4_address": "192.168.112.11"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": []
    },
    "legacy": {
      "image": "novaflow-lab-http:local",
      "container_name": "nf1-legacy",
      "hostname": "nf1-legacy",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "mem_limit": "64m",
      "pids_limit": 32,
      "cpus": 0.25,
      "restart": "no",
      "environment": {
        "LAB_HTTP_USER": "console",
        "LAB_HTTP_PASSWORD": "${LAB_ACTUAL_LEGACY}"
      },
      "networks": {
        "dmz": {
          "ipv4_address": "192.168.112.13"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": [
        "./http_target.py:/app/http_target.py:ro"
      ]
    },
    "app-crm": {
      "image": "auditoria-lab-v2-app:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "mem_limit": "64m",
      "pids_limit": 32,
      "cpus": 0.25,
      "restart": "no",
      "container_name": "nf1-app-crm",
      "environment": {
        "LAB_SCENARIO": "alpha",
        "LAB_FIXTURE_SEED": "${LAB_FIXTURE_SEED:?Ejecute laboratorio-empresa preparar}"
      },
      "networks": {
        "corp": {
          "ipv4_address": "192.168.110.11",
          "ipv6_address": "fd57:2026:110::11"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": []
    },
    "app-intranet": {
      "image": "auditoria-lab-v2-app:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777"
      ],
      "mem_limit": "64m",
      "pids_limit": 32,
      "cpus": 0.25,
      "restart": "no",
      "container_name": "nf1-app-intranet",
      "environment": {
        "LAB_SCENARIO": "strict",
        "LAB_FIXTURE_SEED": "${LAB_FIXTURE_SEED:?Ejecute laboratorio-empresa preparar}"
      },
      "networks": {
        "corp": {
          "ipv4_address": "192.168.110.14",
          "ipv6_address": "fd57:2026:110::14"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": []
    },
    "router": {
      "image": "novaflow-lab-protocol:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777",
        "/run:rw,noexec,nosuid,size=4m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "cpus": 1.0,
      "restart": "no",
      "container_name": "nf1-router",
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW",
        "SETUID",
        "SETGID"
      ],
      "command": [
        "radvd",
        "-n",
        "-m",
        "stderr",
        "-C",
        "/app/datacenter/radvd.conf",
        "-p",
        "/run/radvd.pid"
      ],
      "sysctls": {
        "net.ipv6.conf.all.forwarding": "1"
      },
      "networks": {
        "datacenter": {
          "ipv4_address": "192.168.111.254",
          "ipv6_address": "fd57:2026:111::fe",
          "mac_address": "02:57:20:26:a1:fe"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": [
        "./protocol:/app/datacenter:ro"
      ]
    },
    "sender": {
      "image": "novaflow-lab-protocol:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777",
        "/run:rw,noexec,nosuid,size=4m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "cpus": 1.0,
      "restart": "no",
      "container_name": "nf1-sender",
      "cap_add": [
        "NET_RAW"
      ],
      "command": [
        "sleep",
        "infinity"
      ],
      "networks": {
        "datacenter": {
          "ipv4_address": "192.168.111.10",
          "ipv6_address": "fd57:2026:111::10",
          "mac_address": "02:57:20:26:a1:10"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": [
        "./protocol:/app/datacenter:ro"
      ]
    },
    "receiver-a": {
      "image": "novaflow-lab-protocol:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777",
        "/run:rw,noexec,nosuid,size=4m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "cpus": 1.0,
      "restart": "no",
      "container_name": "nf1-receiver-a",
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "command": [
        "python",
        "/app/datacenter/receiver.py"
      ],
      "environment": {
        "LAB_GUARDED": "0"
      },
      "networks": {
        "datacenter": {
          "ipv4_address": "192.168.111.20",
          "ipv6_address": "fd57:2026:111::20",
          "mac_address": "02:57:20:26:a1:20"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": [
        "./protocol:/app/datacenter:ro"
      ]
    },
    "receiver-b": {
      "image": "novaflow-lab-protocol:local",
      "cap_drop": [
        "ALL"
      ],
      "security_opt": [
        "no-new-privileges:true"
      ],
      "read_only": true,
      "tmpfs": [
        "/tmp:rw,noexec,nosuid,size=16m,mode=1777",
        "/run:rw,noexec,nosuid,size=4m"
      ],
      "mem_limit": "96m",
      "pids_limit": 32,
      "cpus": 1.0,
      "restart": "no",
      "container_name": "nf1-receiver-b",
      "cap_add": [
        "NET_ADMIN",
        "NET_RAW"
      ],
      "command": [
        "python",
        "/app/datacenter/receiver.py"
      ],
      "environment": {
        "LAB_GUARDED": "1"
      },
      "networks": {
        "datacenter": {
          "ipv4_address": "192.168.111.21",
          "ipv6_address": "fd57:2026:111::21",
          "mac_address": "02:57:20:26:a1:21"
        }
      },
      "labels": {
        "novaflow.suite": "1",
        "novaflow.scenario": "sucursal"
      },
      "volumes": [
        "./protocol:/app/datacenter:ro"
      ]
    }
  }
}
